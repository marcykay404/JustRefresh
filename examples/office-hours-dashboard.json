{
  "name": "Ops dashboard during office hours",
  "target": { "patterns": ["*.grafana.example.com"], "exclusions": ["https://grafana.example.com/admin/*"] },
  "trigger": { "type": "interval", "seconds": 300, "randomMaxSeconds": 360 },
