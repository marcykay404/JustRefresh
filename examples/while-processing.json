{
  "name": "Refresh while the order is processing",
  "target": { "patterns": ["^https://shop\\.example\\.com/orders/\\d+$"] },
  "trigger": { "type": "interval", "seconds": 60 },
  "stopWhen": {
    "type": "any",
    "conditions": [
      { "type": "not", "condition": { "type": "dom.text", "selector": ".order-status", "operator": "contains", "value": "Processing" } },
      { "type": "refreshCount", "operator": ">=", "value": 120 },
      { "type": "time.after", "at": "23:00" }
    ]
  },
  "actions": { "onMatched": [{ "type": "stopRefresh" }, { "type": "notify" }, { "type": "log", "message": "Order left processing" }] },
  "safety": { "onUnknown": "skip" }
}
