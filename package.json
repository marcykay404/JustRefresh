{
  "name": "justrefresh",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-driven, agent-programmable auto refresh for Chrome (Manifest V3)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e/run-e2e.mjs",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run bundle:report",
    "complexity": "node scripts/complexity.mjs",
    "complexity:update": "node scripts/complexity.mjs --update",
    "bundle:report": "node scripts/bundle-report.mjs --max-kb 160",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^3.0.7",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
