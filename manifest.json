{
  "manifest_version": 3,
  "name": "Smart Auto Refresh",
  "short_name": "Auto Refresh",
  "version": "0.1.0",
  "description": "Rule-driven auto refresh with URL rules, conditions, activity protection and an agent-programmable API.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Smart Auto Refresh",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "dashboard.html", "open_in_tab": true },
  "permissions": ["tabs", "storage", "alarms", "notifications", "scripting"],
  "optional_permissions": ["nativeMessaging"],
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "externally_connectable": { "ids": ["*"] },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
